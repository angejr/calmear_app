# Application
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication
# Get these from https://dashboard.clerk.com
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
NUXT_CLERK_SECRET_KEY=sk_test_

# Database (Supabase PostgreSQL)
# Use the Transaction pooler connection string from Supabase dashboard
# Project Settings -> Database -> Connection string -> Transaction (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Stripe
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_
# For local dev: copy the whsec_ secret printed by `stripe listen` each time it starts.
# For production: copy the secret from the Stripe Dashboard webhook endpoint.
# WARNING: No leading/trailing spaces — they will break signature verification.
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe Price IDs
# Create these in the Stripe dashboard as recurring prices on the "CalmEar Premium" product
STRIPE_MONTHLY_PRICE_ID=price_
STRIPE_YEARLY_PRICE_ID=price_

# ---------------------------------------------------------------------------
# Production (Fly.io) — do NOT create a .env file on the server.
# At runtime, Nuxt reads NUXT_-prefixed overrides for its runtimeConfig keys,
# so on Fly.io the same values are set under these names with:
#   fly secrets set NAME=value
#
#   NUXT_PUBLIC_APP_URL=https://calmear-app.com
#   NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
#   NUXT_CLERK_SECRET_KEY=sk_live_...
#   NUXT_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
#   NUXT_STRIPE_SECRET_KEY=sk_live_...
#   NUXT_STRIPE_WEBHOOK_SECRET=whsec_...      (from the LIVE webhook endpoint)
#   NUXT_STRIPE_MONTHLY_PRICE_ID=price_...    (live-mode price)
#   NUXT_STRIPE_YEARLY_PRICE_ID=price_...     (live-mode price)
#
# See docs/DEPLOYMENT.md for the full deployment guide.
# ---------------------------------------------------------------------------
