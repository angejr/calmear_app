{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "#imports": ["./tests/__mocks__/imports.ts"]
    }
  },
  "include": [
    "app/**/*",
    "server/**/*",
    "config/**/*",
    "drizzle/**/*",
    "tests/**/*",
    "nuxt.config.ts",
    "drizzle.config.ts",
    "tailwind.config.ts"
  ],
  "exclude": ["node_modules", ".nuxt", ".output", "dist"]
}
